[
    {
      "name" : "consultations-backend",
      "image"  : "${backend_image_uri}",
      "essential" : true,
      "portMappings" : [
        {
          "containerPort" : ${backend_container_port},
          "name"          : "consultations-backend-tcp",
          "protocol"      : "tcp",
          "appProtocol"   : "http"
        }
      ],
      "environment" : [
        {
          "name"  : "AppSettings__Environment__AccountsEnvironment",
          "value" : "${backend_env_appsettings_environment_accountsenvironment}"
        },
        {
          "name"  : "AppSettings__Environment__Name",
          "value" : "${backend_env_appsettings_environment_name}"
        },
        {
          "name"  : "AppSettings__Environment__SsrPort",
          "value" : "${backend_env_appsettings_environment_ssrport}"
        },
        {
          "name"  : "AppSettings__Environment__SsrHost",
          "value" : "${backend_env_appsettings_environment_ssrhost}"
        },
        {
          "name"  : "AppSettings__Environment__CorsOrigin",
          "value" : "${backend_env_appsettings_environment_corsorigin}"
        },
        {
          "name"  : "ConnectionStrings__DefaultConnection",
          "value" : "${backend_env_connectionstrings_defaultconnection}"
        },
        {
          "name"  : "ConsultationList__DownloadRoles__AdminRoles",
          "value" : "${backend_env_consultationlist_downloadroles_adminroles}"
        },
        {
          "name"  : "ConsultationList__DownloadRoles__TeamRoles",
          "value" : "${backend_env_consultationlist_downloadroles_teamroles}"
        },
        {
          "name"  : "Encryption__IV",
          "value" : "${backend_env_encryption_iv}"
        },
        {
          "name"  : "Encryption__Key",
          "value" : "${backend_env_encryption_key}"
        },
        {
          "name"  : "Feeds__CacheDurationSeconds",
          "value" : "${backend_env_feeds_cachedurationseconds}"
        },
        {
          "name"  : "Feeds__IndevApiKey",
          "value" : "${backend_env_feeds_indevapikey}"
        },
        {
          "name"  : "Feeds__IndevBasePath",
          "value" : "${backend_env_feeds_indevbasepath}"
        },
        {
          "name"  : "Feeds__IndevDraftPreviewChapterFeedPath",
          "value" : "${backend_env_feeds_indevdraftpreviewchapterfeedpath}"
        },
        {
          "name"  : "Feeds__IndevDraftPreviewDetailFeedPath",
          "value" : "${backend_env_feeds_indevdraftpreviewdetailfeedpath}"
        },
        {
          "name"  : "Feeds__IndevIDAMConfig__APIIdentifier",
          "value" : "${backend_env_feeds_indevidamconfig_apiidentifier}"
        },
        {
          "name"  : "Feeds__IndevIDAMConfig__ClientId",
          "value" : "${backend_env_feeds_indevidamconfig_clientid}"
        },
        {
          "name"  : "Feeds__IndevIDAMConfig__ClientSecret",
          "value" : "${backend_env_feeds_indevidamconfig_clientsecret}"
        },
        {
          "name"  : "Feeds__IndevIDAMConfig__Domain",
          "value" : "${backend_env_feeds_indevidamconfig_domain}"
        },
        {
          "name"  : "Feeds__IndevListFeedPath",
          "value" : "${backend_env_feeds_indevlistfeedpath}"
        },
        {
          "name"  : "Feeds__IndevPublishedChapterFeedPath",
          "value" : "${backend_env_feeds_indevpublishedchapterfeedpath}"
        },
        {
          "name"  : "Feeds__IndevPublishedDetailFeedPath",
          "value" : "${backend_env_feeds_indevpublisheddetailfeedpath}"
        },
        {
          "name"  : "Feeds__IndevPublishedPreviewDetailFeedPath",
          "value" : "${backend_env_feeds_indevpublishedpreviewdetailfeedpath}"
        },
        {
          "name"  : "Gilliam__GetClaimsUrl",
          "value" : "${backend_env_gilliam_getclaimsurl}"
        },
        {
          "name"  : "Gilliam__GilliamBasePath",
          "value" : "${backend_env_gilliam_gilliambasepath}"
        },
        {
          "name"  : "Gilliam__GilliamClientCertificateBase64",
          "value" : "${backend_env_gilliam_gilliamclientcertificatebase64}"
        },
        {
          "name"  : "GlobalNav__CookieBannerScript",
          "value" : "${backend_env_globalnav_cookiebannerscript}"
        },
        {
          "name"  : "GlobalNav__Script",
          "value" : "${backend_env_globalnav_script}"
        },
        {
          "name"  : "GlobalNav__ScriptIE8",
          "value" : "${backend_env_globalnav_scriptie8}"
        },
        {
          "name"  : "IndevDraftPreviewDetailFeedPath",
          "value" : "${backend_env_indevdraftpreviewdetailfeedpath}"
        },
        {
          "name"  : "Logging__SerilogMinLevel",
          "value" : "${backend_env_logging_serilogminlevel}"
        },
        {
          "name"  : "Status__APIKey",
          "value" : "${backend_env_status_apikey}"
        },
        {
          "name"  : "WebAppConfiguration__ApiIdentifier",
          "value" : "${backend_env_webappconfiguration_apiidentifier}"
        },
        {
          "name"  : "WebAppConfiguration__AuthorisationServiceUri",
          "value" : "${backend_env_webappconfiguration_authorisationserviceuri}"
        },
        {
          "name"  : "WebAppConfiguration__RedirectUri",
          "value" : "${backend_env_webappconfiguration_redirecturi}"
        },
        {
          "name"  : "WebAppConfiguration__PostLogoutRedirectUri",
          "value" : "${backend_env_webappconfiguration_postlogoutredirecturi}"
        },
        {
          "name"  : "WebAppConfiguration__ClientId",
          "value" : "${backend_env_webappconfiguration_clientid}"
        },
        {
          "name"  : "WebAppConfiguration__ClientSecret",
          "value" : "${backend_env_webappconfiguration_clientsecret}"
        },
        {
          "name"  : "WebAppConfiguration__Domain",
          "value" : "${backend_env_webappconfiguration_domain}"
        },
        {
          "name"  : "WebAppConfiguration__GoogleTrackingId",
          "value" : "${backend_env_webappconfiguration_googletrackingid}"
        },
        {
          "name"  : "WebAppConfiguration__RedisServiceConfiguration__ConnectionString",
          "value" : "${backend_env_webappconfiguration_redisserviceconfiguration_connectionstring}"
        },
        {
          "name"  : "WebAppConfiguration__RedisServiceConfiguration__Enabled",
          "value" : "${backend_env_webappconfiguration_redisserviceconfiguration_enabled}"
        }
      ],
      "logConfiguration" : {
        "logDriver" : "awslogs",
        "options" : {
          "awslogs-create-group"  : "true",
          "awslogs-group"         : "/ecs/consultations",
          "awslogs-region"        : "${aws_region}",
          "awslogs-stream-prefix" : "ecs"
        }
      },
      "healthCheck" : {
        "command"  : ["CMD-SHELL", "wget --spider -q http://0.0.0.0:80 || exit 1"],
        "interval" : 120,
        "timeout"  : 60,
        "retries"  : 3
      },
      "dependsOn" : [
        {
          "containerName" : "consultations-database",
          "condition" : "START"
        },
        {
          "containerName" : "consultations-redis",
          "condition" : "START"
        },
        {
          "containerName" : "consultations-frontend",
          "condition" : "START"
        }
      ]
    },
    {
      "name"      : "consultations-frontend",
      "image"     : "${frontend_image_uri}",
      "essential" : true,
      "portMappings" : [
        {
          "hostPort"      : ${frontend_container_port},
          "containerPort" : ${frontend_container_port},
          "name"          : "consultations-frontend-tcp",
          "protocol"      : "tcp",
          "appProtocol"   : "http"
        }
      ],
      "environment" : [
        {
          "name"  : "API_URL",
          "value" : "${frontend_env_api_url}"
        },
        {
          "name"  : "PORT",
          "value" : "${frontend_env_port}"
        },
        {
          "name"  : "PUBLIC_URL",
          "value" : "${frontend_env_public_url}"
        },
        {
          "name"  : "REACT_APP_HOTJARID",
          "value" : "{$frontend_env_react_app_hotjarid}"
        },
        {
          "name"  : "REACT_APP_ACCOUNTS_ENVIRONMENT",
          "value" : "${frontend_env_react_app_accounts_environment}"
        },
        {
          "name"  : "REACT_APP_GLOBAL_NAV_SCRIPT",
          "value" : "${frontend_env_react_app_global_nav_script}"
        },
        {
          "name"  : "REACT_APP_GLOBAL_NAV_SCRIPT_IE8",
          "value" : "${frontend_env_react_app_global_nav_script_ie8}"
        },
        {
          "name"  : "REACT_APP_COOKIE_BANNER_SCRIPT",
          "value" : "${frontend_env_react_app_cookie_banner_script}"
        }
      ],
      "logConfiguration" : {
        "logDriver" : "awslogs",
        "options" : {
          "awslogs-create-group"  : "true",
          "awslogs-group"         : "/ecs/consultations",
          "awslogs-region"        : "${aws_region}",
          "awslogs-stream-prefix" : "ecs"
        }
      }
    },
    {
      "name"      : "consultations-database",
      "image"     : "mcr.microsoft.com/mssql/server:2019-latest",
      "essential" : true,
      "portMappings" : [
        {
          "hostPort"      : 1433,
          "containerPort" : 1433,
          "name"          : "consultations-database-tcp",
          "protocol"      : "tcp",
          "appProtocol"   : "http"
        }
      ],
      "environment" : [
        {
          "name"  : "ACCEPT_EULA",
          "value" : "Y"
        },
        {
          "name"  : "MSSQL_PID",
          "value" : "Express"
        },
        {
          "name"  : "SA_PASSWORD",
          "value" : "ABcd1234#"
        },
        {
          "name"  : "SA_USERNAME",
          "value" : "sa"
        },
        {
          "name"  : "COMPOSE_HTTP_TIMEOUT",
          "value" : "1000"
        }
      ],
      "logConfiguration" : {
        "logDriver" : "awslogs",
        "options" : {
          "awslogs-create-group"  : "true",
          "awslogs-group"         : "/ecs/consultations",
          "awslogs-region"        : "${aws_region}",
          "awslogs-stream-prefix" : "ecs"
        }
      }
    },
    {
      "name"      : "consultations-redis",
      "image"     : "redis:alpine3.15",
      "essential" : true,
      "portMappings" : [
        {
          "hostPort"      : 6379,
          "containerPort" : 6379,
          "name"          : "consultations-redis-tcp",
          "protocol"      : "tcp",
          "appProtocol"   : "http"
        }
      ],
      "logConfiguration" : {
        "logDriver" : "awslogs",
        "options" : {
          "awslogs-create-group"  : "true",
          "awslogs-group"         : "/ecs/consultations",
          "awslogs-region"        : "${aws_region}",
          "awslogs-stream-prefix" : "ecs"
        }
      }
    }
  ]